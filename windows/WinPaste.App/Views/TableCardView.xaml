<UserControl x:Class="WinPaste.App.Views.TableCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             MouseEnter="Root_MouseEnter"
             MouseLeave="Root_MouseLeave"
             MouseLeftButtonUp="Root_MouseLeftButtonUp">
    <Border x:Name="CardBorder"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource BorderHairlineBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="11,9">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="复制整表 (TSV + HTML)" Click="MenuCopy_Click" />
                <MenuItem Header="贴到屏幕 (F3)" Click="MenuPinToScreen_Click" />
                <Separator />
                <MenuItem x:Name="MenuPinItem" Header="置顶" Click="MenuTogglePin_Click" />
                <MenuItem Header="删除" Click="MenuDelete_Click" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏：R 行 × C 列 · time + 右上角置顶 + 悬浮操作 + 展开切换 -->
            <DockPanel Grid.Row="0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="HoverActions" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,4,0">
                        <Button ToolTip="贴到屏幕 (F3)" Style="{StaticResource TactileButtonStyle}" Foreground="{StaticResource AccentBrush}" Padding="5,3" Click="BtnPinToScreen_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPinFillGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10.5" Height="10.5" Stretch="Uniform" Margin="0,0,2.5,0" />
                                <TextBlock Text="贴图" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button ToolTip="置顶" Style="{StaticResource TactileButtonStyle}" Padding="5,3" Click="BtnTogglePin_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPinFillGeometry}" Fill="{StaticResource PinOrangeBrush}" Width="10.5" Height="10.5" Stretch="Uniform" Margin="0,0,2.5,0" />
                                <TextBlock x:Name="BtnPinLabel" Text="置顶" FontSize="11" />
                            </StackPanel>
                        </Button>
                        <Button ToolTip="删除" Style="{StaticResource TactileButtonStyle}" Foreground="{StaticResource DangerRedBrush}" Padding="5,3" Click="BtnDelete_Click">
                            <Path Data="{StaticResource IconDeleteGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11.5" Height="11.5" Stretch="Uniform" />
                        </Button>
                    </StackPanel>

                    <Path x:Name="PinBadge" Data="{StaticResource IconPinFillGeometry}" Fill="{StaticResource PinOrangeBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" Visibility="Collapsed" VerticalAlignment="Center" />

                    <Button Style="{StaticResource TactileButtonStyle}" Padding="6,3" Click="BtnToggleExpand_Click" ToolTip="展开 / 收起完整表格">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ExpandChevron" Text="展开" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,3,0" />
                            <Path x:Name="ExpandChevronIcon" Data="{StaticResource IconChevronDownGeometry}" Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#14007AFF" CornerRadius="4" Padding="5,2" Margin="0,0,7,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconTableGeometry}" Fill="{StaticResource AccentBrush}" Width="10.5" Height="10.5" Stretch="Uniform" Margin="0,0,3,0" />
                            <TextBlock Text="表格" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="HeaderMetaText"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <!-- 收起态：2×6 紧凑预览（每格 74×21） -->
            <ScrollViewer x:Name="CollapsedPreviewScroller"
                          Grid.Row="1"
                          Margin="0,7,0,0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="CollapsedGrid" />
            </ScrollViewer>

            <!-- 展开态：工具栏 + 行号列标可交互矩阵 -->
            <StackPanel x:Name="ExpandedContainer" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed">
                <DockPanel Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnCopyRegion"
                                Content="复制所选区域"
                                Style="{StaticResource AccentPillButtonStyle}"
                                FontSize="11"
                                Visibility="Collapsed"
                                Click="BtnCopyRegion_Click"
                                Margin="0,0,4,0" />
                        <Button x:Name="BtnClearSel"
                                Content="清除选择"
                                Style="{StaticResource TactileButtonStyle}"
                                FontSize="11"
                                Visibility="Collapsed"
                                Click="BtnClearSelection_Click" />
                    </StackPanel>
                    <TextBlock x:Name="SelectionHintText"
                               Text="单击选中单元格 · Shift+单击框选 · 双击复制 · 点行号/列标复制整行整列"
                               FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <ScrollViewer MaxHeight="260"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="ExpandedGrid" />
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
