<Window x:Class="WinPaste.App.Windows.ScreenshotOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="WinPaste 截图"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#10141C"
        Cursor="Cross"
        FontFamily="{StaticResource AppFontFamily}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="RootGrid">
        <!-- 物理像素底层绘图区（底图、暗色遮罩、8控制点、标注、原位翻译层、像素放大镜） -->
        <skia:SKElement x:Name="SkiaCanvas"
                        PaintSurface="SkiaCanvas_PaintSurface"
                        MouseLeftButtonDown="SkiaCanvas_MouseLeftButtonDown"
                        MouseMove="SkiaCanvas_MouseMove"
                        MouseLeftButtonUp="SkiaCanvas_MouseLeftButtonUp"
                        MouseRightButtonUp="SkiaCanvas_MouseRightButtonUp" />

        <!-- WPF 悬浮层（按屏幕 DPI 缩放绘制工具栏、子栏、文字框、提示胶囊） -->
        <Canvas x:Name="OverlayCanvas">
            <!-- 右上角/选区外轻提示胶囊 -->
            <Border x:Name="ToastBadge"
                    Background="#E61E242E"
                    CornerRadius="7"
                    Padding="10,5"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" Foreground="White" FontSize="12" FontWeight="SemiBold" />
            </Border>

            <!-- 行内无边框文字输入框（文字工具激活时出现） -->
            <TextBox x:Name="InlineTextBox"
                     Visibility="Collapsed"
                     AcceptsReturn="True"
                     Background="#33000000"
                     BorderBrush="{StaticResource AccentBrush}"
                     BorderThickness="1"
                     Padding="4,2"
                     MinWidth="80"
                     FontWeight="SemiBold"
                     LostKeyboardFocus="InlineTextBox_LostKeyboardFocus"
                     PreviewKeyDown="InlineTextBox_PreviewKeyDown" />

            <!-- 主悬浮工具栏（选区确定后显示） -->
            <StackPanel x:Name="ToolbarHost" Visibility="Collapsed">
                <Border Background="#F7F9FAFC"
                        BorderBrush="#22000000"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="6,4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Color="#35000000" Opacity="0.28" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 7 种标注工具 -->
                        <Button x:Name="BtnToolRect" Content="矩形" ToolTip="矩形" Style="{StaticResource TactileButtonStyle}" FontSize="11.5" Padding="6,4" Click="ToolBtn_Click" Tag="Rectangle" />
                        <Button x:Name="BtnToolEllipse" Content="圆框" ToolTip="圆框" Style="{StaticResource TactileButtonStyle}" FontSize="11.5" Padding="6,4" Click="ToolBtn_Click" Tag="Ellipse" />
                        <Button x:Name="BtnToolArrow" Content="箭头" ToolTip="箭头" Style="{StaticResource TactileButtonStyle}" FontSize="11.5" Padding="6,4" Click="ToolBtn_Click" Tag="Arrow" />
                        <Button x:Name="BtnToolPen" Content="画笔" ToolTip="画笔" Style="{StaticResource TactileButtonStyle}" FontSize="11.5" Padding="6,4" Click="ToolBtn_Click" Tag="Pen" />
                        <Button x:Name="BtnToolHighlighter" Content="荧光" ToolTip="荧光笔" Style="{StaticResource TactileButtonStyle}" FontSize="11.5" Padding="6,4" Click="ToolBtn_Click" Tag="Highlighter" />
                        <Button x:Name="BtnToolMosaic" Content="马赛克" ToolTip="马赛克" Style="{StaticResource TactileButtonStyle}" FontSize="11.5" Padding="6,4" Click="ToolBtn_Click" Tag="Mosaic" />
                        <Button x:Name="BtnToolText" Content="文字" ToolTip="文字标注" Style="{StaticResource TactileButtonStyle}" FontSize="11.5" Padding="6,4" Click="ToolBtn_Click" Tag="Text" />

                        <Border Width="1" Height="16" Background="#1A000000" Margin="4,0" />

                        <!-- 撤销 / 重做 -->
                        <Button x:Name="BtnUndo" Content="撤销" ToolTip="撤销 (Ctrl+Z)" Style="{StaticResource TactileButtonStyle}" FontSize="11.5" Padding="6,4" IsEnabled="False" Click="BtnUndo_Click" />
                        <Button x:Name="BtnRedo" Content="重做" ToolTip="重做 (Ctrl+Y)" Style="{StaticResource TactileButtonStyle}" FontSize="11.5" Padding="6,4" IsEnabled="False" Click="BtnRedo_Click" />

                        <Border Width="1" Height="16" Background="#1A000000" Margin="4,0" />

                        <!-- 滚动长截图 (L) -->
                        <Button ToolTip="滚动长截图 (L)" Style="{StaticResource TactileButtonStyle}" FontSize="11.5" Padding="6,4" Click="BtnScrollCapture_Click">
                            <TextBlock Text="长截图 (L)" Foreground="#242424" />
                        </Button>

                        <!-- 原位翻译 + 24语种选择 -->
                        <Button x:Name="BtnTranslate" ToolTip="OCR 原位翻译" Style="{StaticResource TactileButtonStyle}" FontSize="11.5" Padding="7,4" Click="BtnTranslate_Click">
                            <TextBlock x:Name="TxtTranslateBtn" Text="翻译" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                        </Button>
                        <ComboBox x:Name="LanguageCombo"
                                  Width="88"
                                  Height="24"
                                  FontSize="11"
                                  Margin="2,0,2,0"
                                  DisplayMemberPath="Name"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="LanguageCombo_SelectionChanged" />
                        <Button x:Name="BtnToggleOriginal"
                                Content="原图"
                                ToolTip="切换 原文/译文 显示"
                                Style="{StaticResource TactileButtonStyle}"
                                FontSize="11"
                                Padding="5,4"
                                Visibility="Collapsed"
                                Click="BtnToggleOriginal_Click" />

                        <Border Width="1" Height="16" Background="#1A000000" Margin="4,0" />

                        <!-- 贴图 / 保存 / 取消 / 完成 -->
                        <Button Content="贴图" ToolTip="贴图到桌面 (F3)" Style="{StaticResource TactileButtonStyle}" FontSize="11.5" Padding="6,4" Click="BtnPin_Click" />
                        <Button Content="保存" ToolTip="保存 PNG (Ctrl+S)" Style="{StaticResource TactileButtonStyle}" FontSize="11.5" Padding="6,4" Click="BtnSave_Click" />
                        <Button Content="取消" ToolTip="取消 (Esc)" Style="{StaticResource TactileButtonStyle}" FontSize="11.5" Padding="6,4" Foreground="{StaticResource DangerRedBrush}" Click="BtnCancel_Click" />
                        <Button Content="完成" ToolTip="复制到剪贴板 (Enter)" Style="{StaticResource AccentPillButtonStyle}" FontSize="11.5" FontWeight="SemiBold" Padding="9,4" Margin="3,0,0,0" Click="BtnDone_Click" />
                    </StackPanel>
                </Border>

                <!-- 颜色与线宽二级面板（选择任意标注工具时展开） -->
                <Border x:Name="StyleSubBar"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Left"
                        Background="#F7F9FAFC"
                        BorderBrush="#22000000"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,5"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="ColorSwatchesHost" Orientation="Horizontal" VerticalAlignment="Center" />
                        <Border Width="1" Height="14" Background="#1A000000" Margin="8,0" />
                        <StackPanel x:Name="StrokeWidthsHost" Orientation="Horizontal" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Canvas>
    </Grid>
</Window>
