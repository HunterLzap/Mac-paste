<Window x:Class="WinPaste.App.Windows.ScreenshotOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="WinPaste 截图"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#10141C"
        Cursor="Cross"
        FontFamily="{StaticResource AppFontFamily}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="RootGrid">
        <!-- 物理像素底层绘图区（底图、暗色遮罩、8控制点、标注、原位翻译层、像素放大镜） -->
        <skia:SKElement x:Name="SkiaCanvas"
                        PaintSurface="SkiaCanvas_PaintSurface"
                        MouseLeftButtonDown="SkiaCanvas_MouseLeftButtonDown"
                        MouseMove="SkiaCanvas_MouseMove"
                        MouseLeftButtonUp="SkiaCanvas_MouseLeftButtonUp"
                        MouseRightButtonUp="SkiaCanvas_MouseRightButtonUp" />

        <!-- WPF 悬浮层（按屏幕 DPI 缩放绘制工具栏、子栏、文字框、提示胶囊） -->
        <Canvas x:Name="OverlayCanvas">
            <!-- 右上角/选区外轻提示胶囊 -->
            <Border x:Name="ToastBadge"
                    Background="#E61E242E"
                    CornerRadius="7"
                    Padding="10,5"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" Foreground="White" FontSize="12" FontWeight="SemiBold" />
            </Border>

            <!-- 行内无边框文字输入框（文字工具激活时出现） -->
            <TextBox x:Name="InlineTextBox"
                     Visibility="Collapsed"
                     AcceptsReturn="True"
                     Background="#33000000"
                     BorderBrush="{StaticResource AccentBrush}"
                     BorderThickness="1"
                     Padding="4,2"
                     MinWidth="80"
                     FontWeight="SemiBold"
                     LostKeyboardFocus="InlineTextBox_LostKeyboardFocus"
                     PreviewKeyDown="InlineTextBox_PreviewKeyDown" />

            <!-- 主悬浮工具栏（选区确定后显示） -->
            <StackPanel x:Name="ToolbarHost" Visibility="Collapsed">
                <Border Background="#F7F9FAFC"
                        BorderBrush="#22000000"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="6,4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Color="#35000000" Opacity="0.28" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 7 种标注工具（纯矢量图标 + 中文 ToolTip，1:1 对齐 Mac 版浮动工具栏） -->
                        <Button x:Name="BtnToolRect" Width="28" Height="26" Padding="0" ToolTip="矩形" Style="{StaticResource TactileButtonStyle}" Click="ToolBtn_Click" Tag="Rectangle">
                            <Path Data="{StaticResource IconToolRectGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="BtnToolEllipse" Width="28" Height="26" Padding="0" ToolTip="圆框" Style="{StaticResource TactileButtonStyle}" Click="ToolBtn_Click" Tag="Ellipse">
                            <Path Data="{StaticResource IconToolEllipseGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="BtnToolArrow" Width="28" Height="26" Padding="0" ToolTip="箭头" Style="{StaticResource TactileButtonStyle}" Click="ToolBtn_Click" Tag="Arrow">
                            <Path Data="{StaticResource IconToolArrowGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="BtnToolPen" Width="28" Height="26" Padding="0" ToolTip="画笔" Style="{StaticResource TactileButtonStyle}" Click="ToolBtn_Click" Tag="Pen">
                            <Path Data="{StaticResource IconToolPenGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13.5" Height="13.5" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="BtnToolHighlighter" Width="28" Height="26" Padding="0" ToolTip="荧光笔" Style="{StaticResource TactileButtonStyle}" Click="ToolBtn_Click" Tag="Highlighter">
                            <Path Data="{StaticResource IconToolHighlighterGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="BtnToolMosaic" Width="28" Height="26" Padding="0" ToolTip="马赛克" Style="{StaticResource TactileButtonStyle}" Click="ToolBtn_Click" Tag="Mosaic">
                            <Path Data="{StaticResource IconToolMosaicGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13.5" Height="13.5" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="BtnToolText" Width="28" Height="26" Padding="0" ToolTip="文字标注" Style="{StaticResource TactileButtonStyle}" Click="ToolBtn_Click" Tag="Text">
                            <Path Data="{StaticResource IconToolTextGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" />
                        </Button>

                        <Border Width="1" Height="16" Background="#1A000000" Margin="4,0" />

                        <!-- 撤销 / 重做 -->
                        <Button x:Name="BtnUndo" Width="28" Height="26" Padding="0" ToolTip="撤销 (Ctrl+Z)" Style="{StaticResource TactileButtonStyle}" IsEnabled="False" Click="BtnUndo_Click">
                            <Path Data="{StaticResource IconUndoGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <Button x:Name="BtnRedo" Width="28" Height="26" Padding="0" ToolTip="重做 (Ctrl+Y)" Style="{StaticResource TactileButtonStyle}" IsEnabled="False" Click="BtnRedo_Click">
                            <Path Data="{StaticResource IconRedoGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" />
                        </Button>

                        <Border Width="1" Height="16" Background="#1A000000" Margin="4,0" />

                        <!-- 滚动长截图 (L) -->
                        <Button ToolTip="滚动长截图 (L)" Style="{StaticResource TactileButtonStyle}" Padding="6,4" Click="BtnScrollCapture_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconScrollCaptureGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0" />
                                <TextBlock Text="长截图" FontSize="11.5" />
                            </StackPanel>
                        </Button>

                        <!-- 原位翻译 + 24语种选择 -->
                        <Button x:Name="BtnTranslate" ToolTip="OCR 原位翻译" Style="{StaticResource TactileButtonStyle}" Foreground="{StaticResource AccentBrush}" Padding="6,4" Click="BtnTranslate_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconTranslateGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13.5" Height="13.5" Stretch="Uniform" Margin="0,0,4,0" />
                                <TextBlock x:Name="TxtTranslateBtn" Text="翻译" FontSize="11.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <ComboBox x:Name="LanguageCombo"
                                  Width="88"
                                  Height="24"
                                  FontSize="11"
                                  Margin="2,0,2,0"
                                  DisplayMemberPath="Name"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="LanguageCombo_SelectionChanged" />
                        <Button x:Name="BtnToggleOriginal"
                                ToolTip="切换 原文/译文 显示"
                                Style="{StaticResource TactileButtonStyle}"
                                Padding="5,4"
                                Visibility="Collapsed"
                                Click="BtnToggleOriginal_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconCompareGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12.5" Height="12.5" Stretch="Uniform" Margin="0,0,3,0" />
                                <TextBlock x:Name="TxtToggleOriginal" Text="原图" FontSize="11" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="16" Background="#1A000000" Margin="4,0" />

                        <!-- 贴图 / 保存 / 取消 / 完成 -->
                        <Button Width="28" Height="26" Padding="0" ToolTip="贴图到桌面 (F3)" Style="{StaticResource TactileButtonStyle}" Click="BtnPin_Click">
                            <Path Data="{StaticResource IconPinFillGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" />
                        </Button>
                        <Button Width="28" Height="26" Padding="0" ToolTip="保存 PNG (Ctrl+S)" Style="{StaticResource TactileButtonStyle}" Click="BtnSave_Click">
                            <Path Data="{StaticResource IconSaveGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13.5" Height="13.5" Stretch="Uniform" />
                        </Button>
                        <Button Width="28" Height="26" Padding="0" ToolTip="取消 (Esc)" Style="{StaticResource TactileButtonStyle}" Foreground="{StaticResource DangerRedBrush}" Click="BtnCancel_Click">
                            <Path Data="{StaticResource IconCloseGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                        <Button ToolTip="复制到剪贴板 (Enter)" Style="{StaticResource AccentPillButtonStyle}" Padding="8,4" Margin="3,0,0,0" Click="BtnDone_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconCheckGeometry}" Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,3,0" />
                                <TextBlock Text="完成" FontSize="11.5" FontWeight="SemiBold" Foreground="White" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 颜色与线宽二级面板（选择任意标注工具时展开） -->
                <Border x:Name="StyleSubBar"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Left"
                        Background="#F7F9FAFC"
                        BorderBrush="#22000000"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,5"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="ColorSwatchesHost" Orientation="Horizontal" VerticalAlignment="Center" />
                        <Border Width="1" Height="14" Background="#1A000000" Margin="8,0" />
                        <StackPanel x:Name="StrokeWidthsHost" Orientation="Horizontal" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Canvas>
    </Grid>
</Window>
