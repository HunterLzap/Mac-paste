<Window x:Class="WinPaste.App.Windows.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFontFamily}"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Grid Margin="6">
        <Border Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Color="#30000000" Opacity="0.22" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 顶栏 -->
                <Border Grid.Row="0"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderHairlineBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="12,12,0,0"
                        Padding="12,9">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="ModeToggleBorder"
                                    Background="{StaticResource SubtleSurfaceBrush}"
                                    CornerRadius="6"
                                    Padding="2"
                                    Margin="0,0,6,0"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnSegView" Content="分段" Style="{StaticResource TactileButtonStyle}" Padding="6,2" FontSize="11" Click="BtnSegView_Click" />
                                    <Button x:Name="BtnRawView" Content="原文" Style="{StaticResource TactileButtonStyle}" Padding="6,2" FontSize="11" Click="BtnRawView_Click" />
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource TactileButtonStyle}" Padding="7,3" Margin="0,0,4,0" Click="BtnPin_Click" ToolTip="贴到屏幕">
                                <TextBlock Text="贴图" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                            </Button>
                            <Button Style="{StaticResource AccentPillButtonStyle}" Padding="8,3" Click="BtnCopyAll_Click">
                                <TextBlock x:Name="CopyAllText" Text="复制全文" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="PinBadge" Text="📌" FontSize="11" Margin="0,0,5,0" Visibility="Collapsed" VerticalAlignment="Center" />
                            <TextBlock x:Name="HeaderTitleText"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 内容区 -->
                <ScrollViewer Grid.Row="1"
                              Padding="12,10"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <StackPanel x:Name="SegmentsHost" />
                        <TextBlock x:Name="RawContentText"
                                   FontSize="12.5"
                                   LineHeight="19"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <Grid x:Name="TablePreviewGrid" Visibility="Collapsed" />
                    </Grid>
                </ScrollViewer>

                <!-- 锚定右上角，左侧/底部/左下角拖拽调整尺寸手柄 -->
                <Thumb Grid.Row="0" Grid.RowSpan="2"
                       Width="6"
                       HorizontalAlignment="Left"
                       Cursor="SizeWE"
                       Opacity="0"
                       DragDelta="LeftThumb_DragDelta" />
                <Thumb Grid.Row="1"
                       Height="6"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNS"
                       Opacity="0"
                       DragDelta="BottomThumb_DragDelta" />
                <Thumb Grid.Row="1"
                       Width="12" Height="12"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNESW"
                       Opacity="0"
                       DragDelta="BottomLeftThumb_DragDelta" />
            </Grid>
        </Border>
    </Grid>
</Window>
