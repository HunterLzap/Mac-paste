<Window x:Class="WinPaste.App.Windows.PinToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFontFamily}"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Border Margin="4"
            Background="#F7F9FAFC"
            BorderBrush="#24000000"
            BorderThickness="1"
            CornerRadius="9"
            Padding="6,4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#30000000" Opacity="0.22" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- 收起 / 展开胶囊 -->
            <Button x:Name="BtnCollapse" ToolTip="收起为胶囊 bar / 展开" Style="{StaticResource TactileButtonStyle}" Padding="6,3" Click="BtnCollapse_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path x:Name="IconCollapse" Data="{StaticResource IconCollapseGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11.5" Height="11.5" Stretch="Uniform" Margin="0,0,3,0" />
                    <TextBlock x:Name="TxtCollapse" Text="收起" FontSize="11" FontWeight="Medium" />
                </StackPanel>
            </Button>

            <!-- 图片专属功能：OCR 取字 + 双语 1-to-1 卡片 -->
            <StackPanel x:Name="ImageOnlyButtons" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="1" Height="15" Background="#1A000000" Margin="4,0" />
                <Button x:Name="BtnOcr" ToolTip="识别图片全部文字" Style="{StaticResource TactileButtonStyle}" Padding="6,3" Click="BtnOcr_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconOcrGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,3.5,0" />
                        <TextBlock x:Name="TxtOcr" Text="识字" FontSize="11" FontWeight="Medium" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnBilingual" ToolTip="切换双语 1-to-1 编号对照卡片" Style="{StaticResource TactileButtonStyle}" Foreground="{StaticResource AccentBrush}" Padding="6,3" Click="BtnBilingual_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconTranslateGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,3.5,0" />
                        <TextBlock x:Name="TxtBilingual" Text="翻译" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Width="1" Height="15" Background="#1A000000" Margin="4,0" />

            <!-- 透明度显示与快捷循环 -->
            <Button x:Name="BtnOpacity" ToolTip="Ctrl+滚轮细腻调透明度，点击快速切换" Style="{StaticResource TactileButtonStyle}" Padding="5,3" Click="BtnOpacityCycle_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconOpacityGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11.5" Height="11.5" Stretch="Uniform" Margin="0,0,3,0" />
                    <TextBlock x:Name="TxtOpacity" Text="100%" FontSize="11" />
                </StackPanel>
            </Button>

            <Border Width="1" Height="15" Background="#1A000000" Margin="4,0" />

            <Button ToolTip="复制当前内容" Style="{StaticResource TactileButtonStyle}" Padding="6,3" Click="BtnCopy_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconCopyGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11.5" Height="11.5" Stretch="Uniform" Margin="0,0,3,0" />
                    <TextBlock Text="复制" FontSize="11" FontWeight="Medium" />
                </StackPanel>
            </Button>
            <Button x:Name="BtnSave" ToolTip="保存为 PNG" Style="{StaticResource TactileButtonStyle}" Padding="6,3" Click="BtnSave_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconSaveGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11.5" Height="11.5" Stretch="Uniform" Margin="0,0,3,0" />
                    <TextBlock Text="保存" FontSize="11" FontWeight="Medium" />
                </StackPanel>
            </Button>
            <Button ToolTip="关闭贴图 (Esc)" Style="{StaticResource TactileButtonStyle}" Padding="5,3" Foreground="{StaticResource DangerRedBrush}" Click="BtnClose_Click">
                <Path Data="{StaticResource IconCloseGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10.5" Height="10.5" Stretch="Uniform" />
            </Button>
        </StackPanel>
    </Border>
</Window>
