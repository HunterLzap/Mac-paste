<Window x:Class="WinPaste.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinPaste 设置"
        Width="370"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        KeyDown="Window_KeyDown">
    <StackPanel Margin="16,14,16,16">
        <!-- 常规设置卡片 -->
        <TextBlock Text="常规" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,6" />
        <Border Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel Margin="0,4">
                    <CheckBox x:Name="ChkLaunchAtLogin"
                              DockPanel.Dock="Right"
                              VerticalAlignment="Center"
                              Checked="ChkLaunchAtLogin_Changed"
                              Unchecked="ChkLaunchAtLogin_Changed" />
                    <TextBlock Text="开机自动启动" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </DockPanel>

                <Separator Background="{StaticResource BorderHairlineBrush}" Margin="0,7" />

                <DockPanel Margin="0,4">
                    <Border DockPanel.Dock="Right" Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="7" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RadClickCopy" Content="仅复制" GroupName="ClickAction" Padding="9,3" FontSize="11.5" Checked="ClickAction_Checked" />
                            <RadioButton x:Name="RadClickPaste" Content="复制并粘贴" GroupName="ClickAction" Padding="9,3" FontSize="11.5" Checked="ClickAction_Checked" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="点击条目时" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </DockPanel>

                <Separator Background="{StaticResource BorderHairlineBrush}" Margin="0,7" />

                <DockPanel Margin="0,4">
                    <CheckBox x:Name="ChkClearPinned"
                              DockPanel.Dock="Right"
                              VerticalAlignment="Center"
                              Checked="ChkClearPinned_Changed"
                              Unchecked="ChkClearPinned_Changed" />
                    <TextBlock Text="清空历史时同时清除置顶" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </DockPanel>

                <Separator Background="{StaticResource BorderHairlineBrush}" Margin="0,7" />

                <DockPanel Margin="0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="−" Width="22" Height="22" Style="{StaticResource TactileButtonStyle}" Padding="0" Click="BtnLimitDec_Click" />
                        <TextBlock x:Name="TxtHistoryLimit" MinWidth="46" TextAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <Button Content="+" Width="22" Height="22" Style="{StaticResource TactileButtonStyle}" Padding="0" Click="BtnLimitInc_Click" />
                    </StackPanel>
                    <TextBlock Text="历史条数上限" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 快捷键说明卡片 -->
        <TextBlock Text="全局快捷键" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,6" />
        <Border Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel Margin="0,3">
                    <Border DockPanel.Dock="Right" Background="{StaticResource SubtleSurfaceBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2">
                        <TextBlock Text="Alt + V" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="呼出 / 隐藏主面板" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel Margin="0,5,0,3">
                    <Border DockPanel.Dock="Right" Background="{StaticResource SubtleSurfaceBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2">
                        <TextBlock Text="Alt + Shift + V" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="按序粘贴下一段" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel Margin="0,5,0,3">
                    <Border DockPanel.Dock="Right" Background="{StaticResource SubtleSurfaceBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2">
                        <TextBlock Text="F1" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="区域截图 / 标注 / 原位翻译" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel Margin="0,5,0,3">
                    <Border DockPanel.Dock="Right" Background="{StaticResource SubtleSurfaceBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2">
                        <TextBlock Text="F3" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="贴图当前剪贴板 / 结束截图贴屏" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel Margin="0,5,0,3">
                    <Border DockPanel.Dock="Right" Background="{StaticResource SubtleSurfaceBrush}" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2">
                        <TextBlock Text="Shift + F3" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="隐藏 / 显示全部贴图" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 底部操作 -->
        <DockPanel>
            <Button DockPanel.Dock="Right"
                    Content="退出 WinPaste"
                    Style="{StaticResource TactileButtonStyle}"
                    Foreground="{StaticResource DangerRedBrush}"
                    Padding="10,6"
                    Click="BtnQuitApp_Click" />
            <Button Content="关闭"
                    Style="{StaticResource TactileButtonStyle}"
                    Padding="12,6"
                    HorizontalAlignment="Left"
                    Click="BtnClose_Click" />
        </DockPanel>
    </StackPanel>
</Window>
