<Window x:Class="WinPaste.App.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WinPaste"
        Width="460"
        Height="600"
        MinWidth="320"
        MinHeight="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource AppFontFamily}"
        Closing="Window_Closing"
        IsVisibleChanged="Window_IsVisibleChanged"
        LocationChanged="Window_BoundsChanged"
        SizeChanged="Window_BoundsChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Margin="6">
        <Border Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Color="#28000000" Opacity="0.22" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. 集成顶栏（可拖拽） -->
                <DockPanel Grid.Row="0" Margin="12,0,10,0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">

                        <!-- 可展开搜索框 -->
                        <Border x:Name="SearchCapsule"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Height="27"
                                MaxWidth="165"
                                Width="0"
                                Opacity="0"
                                Visibility="Collapsed"
                                Margin="0,0,4,0">
                            <DockPanel Margin="7,0,4,0">
                                <Button x:Name="BtnClearSearch"
                                        DockPanel.Dock="Right"
                                        Width="18" Height="18"
                                        Padding="0"
                                        Style="{StaticResource TactileButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="BtnClearSearch_Click">
                                    <TextBlock Text="✕" FontSize="9.5" Foreground="{StaticResource TextTertiaryBrush}" />
                                </Button>
                                <TextBox x:Name="SearchTextBox"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="12"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         VerticalContentAlignment="Center"
                                         PreviewMouseLeftButtonDown="SearchTextBox_PreviewMouseLeftButtonDown"
                                         TextChanged="SearchTextBox_TextChanged"
                                         LostFocus="SearchTextBox_LostFocus" />
                            </DockPanel>
                        </Border>

                        <Button ToolTip="搜索 (Ctrl+F)" Style="{StaticResource TactileButtonStyle}" Padding="6,5" Click="BtnToggleSearch_Click">
                            <Path Data="M11 4a7 7 0 1 0 4.6 12.2l3.8 3.8 1.2-1.2-3.8-3.8A7 7 0 0 0 11 4zm0 1.7a5.3 5.3 0 1 1 0 10.6 5.3 5.3 0 0 1 0-10.6z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="14" Height="14" Stretch="Uniform" />
                        </Button>

                        <Button ToolTip="区域截图 (F1)" Style="{StaticResource TactileButtonStyle}" Padding="6,5" Click="BtnSnip_Click">
                            <Path Data="M4 2h2v3h11v11h3v2h-3v3h-2v-3H4V2zm2 5v9h9V7H6z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="14" Height="14" Stretch="Uniform" />
                        </Button>

                        <Button ToolTip="贴图当前剪贴板 (F3)" Style="{StaticResource TactileButtonStyle}" Padding="6,5" Click="BtnPinCurrent_Click">
                            <Path Data="M14 3l7 7-1.5 1.5-2-1-4.5 4.5.5 3.5-1.5 1.5-3.8-3.8L3 21.4 2.6 21l5.2-5.2L4 12l1.5-1.5 3.5.5 4.5-4.5-1-2L14 3z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="13.5" Height="13.5" Stretch="Uniform" />
                        </Button>

                        <Button x:Name="BtnAlwaysOnTop" ToolTip="窗口置顶" Style="{StaticResource TactileButtonStyle}" Padding="6,5" Click="BtnAlwaysOnTop_Click">
                            <Path x:Name="IconAlwaysOnTop"
                                  Data="M6 3h12v2h-5v8.2l3.2 2.3V17H7.8v-1.5L11 13.2V5H6V3zm5 14h2v4h-2v-4z"
                                  Fill="{StaticResource TextSecondaryBrush}"
                                  Width="13.5" Height="13.5" Stretch="Uniform" />
                        </Button>

                        <Button ToolTip="设置" Style="{StaticResource TactileButtonStyle}" Padding="6,5" Click="BtnSettings_Click">
                            <Path Data="M19.4 13a7.9 7.9 0 0 0 .1-1 7.9 7.9 0 0 0-.1-1l2.1-1.6-2-3.5-2.5 1a7.4 7.4 0 0 0-1.7-1L15 3h-4l-.3 2.9a7.4 7.4 0 0 0-1.7 1l-2.5-1-2 3.5L6.6 11a7.9 7.9 0 0 0-.1 1c0 .3 0 .7.1 1L4.5 14.6l2 3.5 2.5-1c.5.4 1.1.7 1.7 1L11 21h4l.3-2.9c.6-.3 1.2-.6 1.7-1l2.5 1 2-3.5L19.4 13zM13 15a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="14" Height="14" Stretch="Uniform" />
                        </Button>

                        <Button ToolTip="隐藏面板 (Esc)" Style="{StaticResource TactileButtonStyle}" Padding="6,5" Click="BtnHide_Click">
                            <Path Data="{StaticResource IconCloseGeometry}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="11.5" Height="11.5" Stretch="Uniform" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentBrush}" Margin="0,0,7,0">
                            <Path Data="{StaticResource IconClipboardGeometry}" Fill="White" Width="13" Height="13" Stretch="Uniform" />
                        </Border>
                        <TextBlock x:Name="AppTitleText"
                                   Text="WinPaste"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <!-- 2. 4 分类分段选择器 -->
                <Border Grid.Row="1"
                        Margin="12,2,12,8"
                        Background="{StaticResource SubtleSurfaceBrush}"
                        BorderBrush="{StaticResource BorderHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="3">
                    <UniformGrid Columns="4">
                        <Button x:Name="TabShortBtn" Style="{StaticResource TactileButtonStyle}" FontSize="12" Padding="0,5" Click="Tab_Click" Tag="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconShortTextGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" />
                                <TextBlock Text="短文本" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabLongBtn" Style="{StaticResource TactileButtonStyle}" FontSize="12" Padding="0,5" Click="Tab_Click" Tag="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconLongTextGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" />
                                <TextBlock Text="长文本" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabImageBtn" Style="{StaticResource TactileButtonStyle}" FontSize="12" Padding="0,5" Click="Tab_Click" Tag="2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconImageGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12.5" Height="12.5" Stretch="Uniform" Margin="0,0,4,0" />
                                <TextBlock Text="图片" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabTableBtn" Style="{StaticResource TactileButtonStyle}" FontSize="12" Padding="0,5" Click="Tab_Click" Tag="3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconTableGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" />
                                <TextBlock Text="表格" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Border>

                <!-- 3. 历史列表区 + 空状态 -->
                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="HistoryScroller"
                                  Padding="12,0,12,8"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <StackPanel x:Name="LinearItemsHost" />
                            <UniformGrid x:Name="ImageGridHost" Columns="3" VerticalAlignment="Top" Visibility="Collapsed" />
                        </Grid>
                    </ScrollViewer>

                    <StackPanel x:Name="EmptyStatePanel"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource SubtleSurfaceBrush}" Margin="0,0,0,10">
                            <Path Data="{StaticResource IconClipboardGeometry}" Fill="{StaticResource TextTertiaryBrush}" Width="22" Height="22" Stretch="Uniform" />
                        </Border>
                        <TextBlock x:Name="EmptyStateLabel"
                                   Text="暂无剪贴板历史"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 4. 页脚：条数统计 + 清空历史 -->
                <Border Grid.Row="3"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderHairlineBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,7">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource TactileButtonStyle}"
                                Foreground="{StaticResource DangerRedBrush}"
                                Padding="8,3"
                                Click="BtnClearHistory_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconDeleteGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11.5" Height="11.5" Stretch="Uniform" Margin="0,0,3.5,0" />
                                <TextBlock Text="清空历史" FontSize="11.5" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="FooterCountText"
                                   Text="共 0 条"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
